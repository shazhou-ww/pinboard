{
  "name": "@shazhou/pinboard-encoding",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --root . --config ../../vitest.config.ts --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ipld/car": "catalog:",
    "@shazhou/pinboard-contracts": "workspace:*",
    "ipfs-unixfs-importer": "catalog:",
    "multiformats": "catalog:"
  }
}
