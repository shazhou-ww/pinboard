{
  "name": "@shazhou/pinboard-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preview:assets": "node scripts/build-preview-assets.mjs",
    "build": "wrangler deploy --dry-run --outdir dist --config wrangler.jsonc",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "dev": "wrangler dev --config wrangler.jsonc",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm preview:assets && vitest run --config vitest.config.ts --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "types": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@libp2p/crypto": "catalog:",
    "ipns": "catalog:",
    "@hyzyla/pdfium": "catalog:",
    "@jsquash/jpeg": "catalog:",
    "@jsquash/png": "catalog:",
    "@jsquash/webp": "catalog:",
    "@ipld/car": "catalog:",
    "@ipld/dag-cbor": "catalog:",
    "@ipld/dag-pb": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "ipfs-unixfs-importer": "catalog:",
    "ipfs-unixfs-exporter": "catalog:",
    "fflate": "catalog:",
    "multiformats": "catalog:",
    "zod": "catalog:",
    "@auth/core": "catalog:",
    "@hono/auth-js": "catalog:",
    "@shazhou/pinboard-contracts": "workspace:*",
    "@shazhou/pinboard-web": "workspace:*",
    "hono": "catalog:"
  },
  "devDependencies": {
    "wabt": "catalog:",
    "@shazhou/pinboard-encoding": "workspace:*",
    "@shazhou/pinboard": "workspace:*",
    "miniflare": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "wrangler": "catalog:"
  }
}
