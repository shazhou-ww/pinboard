{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pinboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["17 * * * *"] },
  "assets": {
    "binding": "ASSETS",
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/ipfs/*",
      "/routing/*",
      "/mcp",
      "/oauth/*",
      "/.well-known/*",
    ],
  },
  "vars": {
    "APP_NAME": "Pinboard",
    "PUBLIC_ORIGIN": "https://pinboard.shazhou.work",
    "PROVIDER_MULTIADDR": "/dns4/pinboard.shazhou.work/tcp/443/tls/http",
    "PROVIDER_ID": "12D3KooWCjfPiojcCUmv78Wd1NJzi4Mraj1moxigp7AfQVQvGLwH",
  },
  "r2_buckets": [{ "binding": "BLOCKS", "bucket_name": "pinboard-blocks" }],
  "ratelimits": [
    {
      "name": "OAUTH_REGISTRATION_LIMITER",
      "namespace_id": "26110601",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "OAUTH_AUTHORIZATION_LIMITER",
      "namespace_id": "26110602",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "OAUTH_TOKEN_LIMITER",
      "namespace_id": "26110603",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pinboard",
      "database_id": "9f15fd50-e103-459f-9f3f-9db3036f91de",
      "migrations_dir": "migrations",
    },
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
  },
}
