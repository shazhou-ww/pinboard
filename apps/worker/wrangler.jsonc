{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pinboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["17 * * * *"] },
  "assets": {
    "binding": "ASSETS",
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ipfs/*", "/routing/*", "/mcp"],
  },
  "vars": {
    "APP_NAME": "Pinboard",
    "PUBLIC_ORIGIN": "https://pinboard.shazhou.work",
    "PROVIDER_MULTIADDR": "/dns4/pinboard.shazhou.work/tcp/443/tls/http",
    "PROVIDER_ID": "12D3KooWCjfPiojcCUmv78Wd1NJzi4Mraj1moxigp7AfQVQvGLwH",
  },
  "r2_buckets": [{ "binding": "BLOCKS", "bucket_name": "pinboard-blocks" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pinboard",
      "database_id": "625b568d-106b-4fe1-af33-3eac4fe0a354",
      "migrations_dir": "migrations",
    },
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
  },
}
