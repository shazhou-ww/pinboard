      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "PROVIDER_MULTIADDR": "/ip4/127.0.0.1/tcp/9443/tls/http",
    "PROVIDER_ID": "12D3KooWCjfPiojcCUmv78Wd1NJzi4Mraj1moxigp7AfQVQvGLwH",
  },
}
