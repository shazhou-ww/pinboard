{
  "name": "pinboard",
  "version": "0.0.0",
  "description": "Pin blocks. Share by CID. Lightweight public IPFS storage on Cloudflare.",
  "keywords": [
    "typescript",
    "cloudflare",
    "workers",
    "react",
    "hono",
    "oauth",
    "ipfs",
    "cid",
    "r2",
    "mcp"
  ],
  "homepage": "https://pinboard.shazhou.work",
  "bugs": {
    "url": "https://github.com/shazhou-ww/pinboard/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shazhou-ww/pinboard.git"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm test:release && turbo run lint typecheck test build && pnpm test:cli-package",
    "clean": "turbo run clean && node -e \"require('node:fs').rmSync('.turbo', { recursive: true, force: true })\"",
    "deploy": "pnpm build && pnpm --filter @shazhou/pinboard-worker deploy",
    "dev": "pnpm --filter @shazhou/pinboard-web build && turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "package:cli": "turbo run build --filter=@shazhou/pinboard && node scripts/package-cli.mjs",
    "test": "turbo run test",
    "test:kubo": "pnpm --filter @shazhou/pinboard-contracts build && node scripts/kubo-poc.mjs",
    "test:release": "node --test scripts/validate-release.test.mjs scripts/validate-cli-release.test.mjs",
    "test:cli-package": "pnpm package:cli && node --test scripts/cli-package.test.mjs",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@auth/core": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@eslint/js": "catalog:",
    "@fontsource-variable/instrument-sans": "catalog:",
    "@fontsource-variable/newsreader": "catalog:",
    "@hono/auth-js": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "hono": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
